-- item_manager.script
function init(self)
	-- Spawn an initial batch of items
	for i = 1, 10 do
		spawn_item()
	end
end

function spawn_item()
	local position = vmath.vector3(math.random(0, 800), math.random(0, 600), 0)
	factory.create("#item_factory", position)
end

function update(self, dt)
	-- Optionally, spawn new items over time or based on other conditions
end